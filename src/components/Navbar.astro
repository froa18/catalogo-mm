---
/**
 * Barra de navegación fija: menú a la izquierda, logotipo al centro y la bolsa
 * con el conteo de piezas a la derecha.
 *
 * El nombre de la marca vive acá y solo acá: la portada ya no repite un
 * logotipo grande arriba.
 */
import Marca from './Marca.astro';
import { ANUNCIO } from '../config.js';
---

{ANUNCIO.activo && <p class="anuncio">{ANUNCIO.texto}</p>}

<header class="navbar">
  <div class="envoltura fila">
    <button type="button" class="icono menu" data-menu-abrir aria-label="Abrir menú">
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M3 6h18"></path>
        <path d="M3 12h18"></path>
        <path d="M3 18h18"></path>
      </svg>
    </button>

    <span class="marca-barra">
      <Marca compacta enlace />
    </span>

    <button
      type="button"
      class="icono bolsa"
      data-carrito-abrir
      aria-label="Ver mi pedido"
    >
      <svg
        width="21"
        height="21"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
        <path d="M3 6h18"></path>
        <path d="M16 10a4 4 0 0 1-8 0"></path>
      </svg>
      <span class="conteo" data-carrito-conteo hidden>0</span>
    </button>
  </div>
</header>

<style>
  .anuncio {
    margin: 0;
    padding: var(--e2) var(--e4);
    background: var(--acento-hondo);
    color: var(--hueso);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
  }

  .navbar {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--hueso) 90%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--hueso-borde);
  }

  .fila {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: var(--alto-navbar);
  }

  .marca-barra {
    justify-self: center;
  }

  /* --- Iconos de los extremos ----------------------------------- */

  .icono {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: none;
    border-radius: 50%;
    color: var(--tinta);
  }

  .icono:hover {
    background: var(--hueso-hondo);
  }

  .menu {
    justify-self: start;
    /* El trazo del icono queda a ras del margen, como el resto del contenido */
    margin-left: -10px;
  }

  .bolsa {
    position: relative;
    justify-self: end;
    margin-right: -10px;
  }

  .conteo {
    position: absolute;
    top: 1px;
    right: 0;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    background: var(--acento-hondo);
    border-radius: 100px;
    color: var(--hueso);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 18px;
    font-variant-numeric: tabular-nums;
  }

  .conteo[hidden] {
    display: none;
  }
</style>
