---
import Flat from './Flat.astro';
import { formatearPrecio } from '../utils/formato.js';

interface Props {
  /** Solo la foto y su etiqueta de precio, sin la ficha de texto debajo. */
  soloImagen?: boolean;
  producto: {
    id: string;
    codigo: string;
    nombre: string;
    descripcion: string;
    categoria: string;
    precioUSD: number;
    tallas: string[];
    colores: { nombre: string; hex: string; imagen?: string }[];
    imagen: string | null;
    etiqueta: string | null;
  };
}

const { producto, soloImagen = false } = Astro.props;
const agotado = producto.tallas.length === 0;
---

<a
  class:list={['tarjeta', { 'solo-imagen': soloImagen }]}
  href={`/producto/${producto.id}/`}
  data-categoria={producto.categoria}
  data-id={producto.id}
>
  <div class="lienzo">
    {
      producto.imagen ? (
        <img src={producto.imagen} alt={producto.nombre} loading="lazy" />
      ) : (
        <Flat categoria={producto.categoria} class="flat" />
      )
    }

    {producto.etiqueta && <span class="distintivo">{producto.etiqueta}</span>}
  </div>

  {
    /* Sin ficha visible, el enlace necesita igual un nombre que dictar */
    soloImagen && (
      <span class="oculto-visual">
        {producto.nombre} — {formatearPrecio(producto.precioUSD)}
      </span>
    )
  }

  <div class="info">
    <div class="encabezado">
      <h3 class="nombre">{producto.nombre}</h3>
      <p class="precio">{formatearPrecio(producto.precioUSD)}</p>
    </div>
    <p class="descripcion">{producto.descripcion}</p>

    <p class="oculto-visual">Código: {producto.codigo}</p>

    <div class="variantes">
      <ul class="colores" aria-label="Colores disponibles">
        {
          producto.colores.map((c) => (
            <li>
              <span class="muestra" style={`--muestra: ${c.hex}`} />
              <span class="oculto-visual">{c.nombre}</span>
            </li>
          ))
        }
      </ul>

      <p class="tallas">
        {agotado ? 'Agotado' : producto.tallas.join(' · ')}
      </p>
    </div>
  </div>
</a>

<style>
  /* La pieza va sobre una tarjeta blanca que flota apenas sobre el fondo:
     la sombra separa sin necesidad de bordes ni botones dentro de la
     tarjeta — al tocarla se entra a la ficha, que es donde se elige. */
  .tarjeta {
    display: flex;
    flex-direction: column;
    padding: var(--e2) var(--e2) var(--e4);
    background: #fff;
    border-radius: 14px;
    box-shadow:
      0 1px 2px rgb(74 32 40 / 0.05),
      0 6px 16px rgb(74 32 40 / 0.06);
    color: inherit;
    text-decoration: none;
    transition:
      transform var(--transicion),
      box-shadow var(--transicion);
  }

  .tarjeta:hover {
    transform: translateY(-3px);
    box-shadow:
      0 2px 4px rgb(74 32 40 / 0.06),
      0 14px 28px rgb(74 32 40 / 0.1);
  }

  .tarjeta:hover .nombre {
    color: var(--acento-hondo);
  }

  /* --- Zona de imagen ------------------------------------------ */

  .lienzo {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--hueso-hondo);
    /* Radio interior menor que el de la tarjeta, como en las piezas reales */
    border-radius: 9px;
    overflow: hidden;
    display: grid;
    place-items: center;
  }

  .lienzo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .flat {
    width: 62%;
    height: auto;
    color: var(--tinta-suave);
  }

  /* --- Distintivo ("Nuevo", "Últimas piezas") ------------------- */

  .distintivo {
    position: absolute;
    bottom: var(--e3);
    left: var(--e3);
    padding: 3px var(--e2);
    background: var(--acento-hondo);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: var(--radio);
  }

  /* --- Información --------------------------------------------- */

  .info {
    padding: var(--e3) var(--e2) 0;
  }

  .encabezado {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--e2);
  }

  .precio {
    flex: none;
    font-family: var(--serif);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  /* En el carrusel la tarjeta es solo la pieza: sin texto y sin el aire que
     lo acompañaba. */
  .solo-imagen {
    padding: var(--e2);
  }

  .solo-imagen .info {
    display: none;
  }

  .solo-imagen .distintivo {
    padding: 2px 6px;
    font-size: 0.625rem;
  }

  .nombre {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.0625rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .descripcion {
    margin: var(--e1) 0 0;
    color: var(--tinta-media);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .variantes {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e3);
    margin-top: var(--e3);
  }

  .colores {
    display: flex;
    gap: 5px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .muestra {
    display: block;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--muestra);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.14);
  }

  .tallas {
    margin: 0;
    color: var(--tinta-suave);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

</style>
