---
import Flat from './Flat.astro';
import { formatearPrecio } from '../utils/formato.js';

interface Props {
  producto: {
    id: string;
    nombre: string;
    descripcion: string;
    categoria: string;
    precioUSD: number;
    tallas: string[];
    colores: { nombre: string; hex: string }[];
    imagen: string | null;
    etiqueta: string | null;
  };
}

const { producto } = Astro.props;
const agotado = producto.tallas.length === 0;
---

<a
  class="tarjeta"
  href={`/producto/${producto.id}/`}
  data-categoria={producto.categoria}
  data-id={producto.id}
>
  <div class="lienzo">
    {
      producto.imagen ? (
        <img src={producto.imagen} alt={producto.nombre} loading="lazy" />
      ) : (
        <Flat categoria={producto.categoria} class="flat" />
      )
    }

    {producto.etiqueta && <span class="distintivo">{producto.etiqueta}</span>}

    {/* Etiqueta colgante con el precio — detalle de marca */}
    <div class="colgante" aria-hidden="true">
      <span class="cuerda"></span>
      <span class="etiqueta">
        <span class="precio">{formatearPrecio(producto.precioUSD)}</span>
      </span>
    </div>
  </div>

  <div class="info">
    <h3 class="nombre">{producto.nombre}</h3>
    <p class="descripcion">{producto.descripcion}</p>

    <p class="oculto-visual">
      Precio: {formatearPrecio(producto.precioUSD)}
    </p>

    <div class="variantes">
      <ul class="colores" aria-label="Colores disponibles">
        {
          producto.colores.map((c) => (
            <li>
              <span class="muestra" style={`--muestra: ${c.hex}`} />
              <span class="oculto-visual">{c.nombre}</span>
            </li>
          ))
        }
      </ul>

      <p class="tallas">
        {agotado ? 'Agotado' : producto.tallas.join(' · ')}
      </p>
    </div>
  </div>
</a>

<style>
  .tarjeta {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .tarjeta:hover .lienzo {
    border-color: var(--sage);
  }

  .tarjeta:hover .nombre {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--sage);
  }

  /* --- Zona de imagen ------------------------------------------ */

  .lienzo {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--hueso-hondo);
    border: 1px solid var(--hueso-borde);
    border-radius: var(--radio);
    overflow: hidden;
    display: grid;
    place-items: center;
  }

  .lienzo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .flat {
    width: 62%;
    height: auto;
    color: var(--tinta-suave);
  }

  /* --- Distintivo ("Nuevo", "Últimas piezas") ------------------- */

  .distintivo {
    position: absolute;
    top: var(--e3);
    left: var(--e3);
    padding: 3px var(--e2);
    background: var(--sage);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: var(--radio);
  }

  /* --- Etiqueta colgante --------------------------------------- */

  .colgante {
    position: absolute;
    top: 0;
    right: var(--e5);
    display: flex;
    flex-direction: column;
    align-items: center;
    transform-origin: 50% 0;
    transform: rotate(-3deg);
    transition: transform var(--transicion);
  }

  .cuerda {
    width: 1px;
    height: 26px;
    background: var(--tinta-suave);
    opacity: 0.55;
  }

  .etiqueta {
    position: relative;
    display: grid;
    place-items: center;
    min-width: 62px;
    padding: 16px var(--e3) var(--e2);
    background: var(--hueso);
    border: 1px solid var(--hueso-borde);
    /* Esquinas superiores biseladas, como una etiqueta real */
    clip-path: polygon(0 14%, 50% 0, 100% 14%, 100% 100%, 0 100%);
  }

  /* El agujero por donde pasa la cuerda */
  .etiqueta::before {
    content: '';
    position: absolute;
    top: 9px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--hueso-hondo);
    box-shadow: inset 0 0 0 1px var(--hueso-borde);
  }

  .precio {
    font-family: var(--serif);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .tarjeta:hover .colgante {
    transform: rotate(1.5deg);
  }

  /* --- Información --------------------------------------------- */

  .info {
    padding-top: var(--e3);
  }

  .nombre {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.0625rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .descripcion {
    margin: var(--e1) 0 0;
    color: var(--tinta-media);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .variantes {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e3);
    margin-top: var(--e3);
  }

  .colores {
    display: flex;
    gap: 5px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .muestra {
    display: block;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--muestra);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.14);
  }

  .tallas {
    margin: 0;
    color: var(--tinta-suave);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  @media (prefers-reduced-motion: reduce) {
    .colgante {
      transition: none;
    }
    .tarjeta:hover .colgante {
      transform: rotate(-3deg);
    }
  }
</style>
