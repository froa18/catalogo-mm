---
import '../styles/global.css';
import { MARCA } from '../config.js';
import Navbar from '../components/Navbar.astro';
import CarritoPanel from '../components/CarritoPanel.astro';

interface Props {
  titulo?: string;
  descripcion?: string;
  /** Ruta de imagen para la previsualización al compartir el enlace. */
  imagen?: string | null;
  /**
   * En la portada el logotipo de la barra espera a que la cabecera salga de
   * pantalla; en el resto de las páginas está desde el principio.
   */
  marcaConScroll?: boolean;
}

const {
  titulo = `${MARCA.nombre} — ${MARCA.descripcion}`,
  descripcion = 'Catálogo de blusas. Elegí tu talla y color, armá tu pedido y envialo por WhatsApp.',
  imagen = null,
  marcaConScroll = false,
} = Astro.props;

const urlCanonica = new URL(Astro.url.pathname, Astro.site);
const urlImagen = imagen ? new URL(imagen, Astro.site) : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#f9f5f3" />
    <link rel="canonical" href={urlCanonica} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={urlCanonica} />
    {urlImagen && <meta property="og:image" content={urlImagen} />}
    <meta
      name="twitter:card"
      content={urlImagen ? 'summary_large_image' : 'summary'}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Navbar revelarConScroll={marcaConScroll} />
    <slot />
    <CarritoPanel />
  </body>
</html>
